[Desktop Entry]
Name=secrets-launch
Comment=Execute desktop entry inside secrets slice
# Fuzzel sets DESKTOP_ENTRY_ID which is used by the script, any launcher that
# sets the same variable and can use launch prefix should work
Exec=fuzzel --placeholder="Will launch inside secrets slice" --launch-prefix="vpnslice-launch --slice secrets"
Icon=utilities-terminal
Type=Application
Categories=Work;
